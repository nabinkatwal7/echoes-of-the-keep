DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dnd"
# Generate with: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET=""
# Optional OAuth providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Optional email magic links (SMTP URL, e.g. smtp://user:pass@host:587)
EMAIL_SERVER=
EMAIL_FROM="D&D <no-reply@example.com>"
# FULL = all extracted handbook content, SRD_ONLY = public-safe subset
CONTENT_LICENSE_MODE=FULL
