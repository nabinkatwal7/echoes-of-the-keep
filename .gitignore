# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database backups
/backups/

# playwright output
/test-results/
/playwright-report/

# copyrighted source material: supply your own copy to run the importer (see docs/04-content-pipeline.md)
*.pdf
/content/extracted/

# editor and assistant settings
/.claude/
/.vscode/

# scratch notes
/instructions.txt

# personal roadmap
/NEXT_FEATURES.md
