{
  "name": "dungeons-and-dragons",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "content:extract": "python content/build/extract_phb.py && python content/build/parse_spells.py && python content/build/parse_content.py && python content/build/report.py",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:db": "cross-env RUN_DB_TESTS=1 vitest run tests",
    "spells:coverage": "tsx scripts/spell-coverage.ts",
    "db:seed:srd": "cross-env CONTENT_LICENSE_MODE=SRD_ONLY prisma db seed",
    "backup": "node scripts/backup.mjs",
    "purge:accounts": "tsx scripts/purge-deleted.ts",
    "load-test": "node scripts/load-test.mjs",
    "e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tabler/icons-react": "^3.30.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "motion": "^12.4.2",
    "next": "15.1.7",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
