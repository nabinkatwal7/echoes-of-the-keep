generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Accounts are username + password only (no third-party sign-in).
model User {
  id           String           @id @default(cuid())
  /// lowercase login name, 3-24 characters: a-z, 0-9, underscore
  username     String           @unique
  displayName  String
  /// scrypt hash, see lib/password.ts
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  characters   Character[]
  memberships  CampaignMember[]
  campaignsDm  Campaign[]
}

// Rules content (seeded from content/, read-only at runtime)
model Alignment {
  index        String @id
  name         String
  abbreviation String
  description  String
  source       String @default("PHB")
  page         Int?
}

model Condition {
  index       String @id
  name        String
  description String
  source      String @default("PHB")
  pdfPages    Int[]
}

model Feat {
  index        String  @id
  name         String
  prerequisite String?
  description  String
  source       String  @default("PHB")
  pdfPages     Int[]
}

model Background {
  index              String  @id
  name               String
  skillProficiencies String?
  toolProficiencies  String?
  languages          String?
  equipment          String?
  featureName        String?
  text               String
  source             String  @default("PHB")
  pdfPages           Int[]
}

model Spell {
  index         String   @id
  name          String
  level         Int
  school        String
  ritual        Boolean  @default(false)
  concentration Boolean  @default(false)
  castingTime   String
  range         String
  components    String
  duration      String
  description   String
  higherLevels  String   @default("")
  classes       String[]
  source        String   @default("PHB")

  @@index([level])
}

model Race {
  index    String @id
  name     String
  traits   Json
  text     String
  source   String @default("PHB")
  pdfPages Int[]
}

model Class {
  index         String @id
  name          String
  hitDie        Int
  proficiencies Json
  levelTable    Json
  text          String
  source        String @default("PHB")
  pdfPages      Int[]
}

model Creature {
  index             String  @id
  name              String
  size              String
  type              String
  alignment         String
  armorClass        String?
  hitPoints         String?
  speed             String?
  abilities         Json?
  savingThrows      String?
  skills            String?
  damageResistances String?
  senses            String?
  languages         String?
  challenge         String?
  text              String
  source            String  @default("PHB")
  pdfPages          Int[]
}

model EquipmentItem {
  index               String   @id
  name                String
  category            String?
  cost                String
  weight              String?
  damage              String?
  properties          String?
  armorClass          String?
  strengthRequired    String?
  stealthDisadvantage Boolean?
  details             String   @default("")
  source              String   @default("PHB")
  pdfPage             Int
}

model Character {
  id                 String              @id @default(cuid())
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  raceIndex          String
  subraceIndex       String?
  backgroundIndex    String
  alignment          String?
  /// [{ classIndex, level, subclassIndex? }]
  classes            Json
  baseScores         Json
  abilityMethod      String
  /// racial bonuses plus ability score improvements, per ability
  scoreBonuses       Json                @default("{}")
  skillProficiencies Json                @default("[]")
  skillExpertise     Json                @default("[]")
  feats              Json                @default("[]")
  speed              Int                 @default(30)
  xp                 Int                 @default(0)
  inspiration        Boolean             @default(false)
  currentHp          Int
  tempHp             Int                 @default(0)
  hitDiceSpent       Json                @default("{}")
  deathSaves         Json                @default("{\"successes\":0,\"failures\":0}")
  conditions         Json                @default("[]")
  exhaustion         Int                 @default(0)
  currency           Json                @default("{\"cp\":0,\"sp\":0,\"ep\":0,\"gp\":0,\"pp\":0}")
  equipment          Json                @default("[]")
  spellSlotsUsed     Json                @default("[]")
  resources          Json                @default("[]")
  personality        Json                @default("{}")
  /// { known: string[], prepared: string[], spellbook: string[] } spell indexes
  spells             Json                @default("{}")
  notes              String              @default("")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  campaigns          CampaignCharacter[]

  @@index([ownerId])
}

model Campaign {
  id          String              @id @default(cuid())
  name        String
  description String              @default("")
  dmId        String
  dm          User                @relation(fields: [dmId], references: [id], onDelete: Cascade)
  inviteCode  String              @unique
  /// house rules: feats, multiclassing, encumbrance, ...
  settings    Json                @default("{}")
  createdAt   DateTime            @default(now())
  members     CampaignMember[]
  characters  CampaignCharacter[]
  events      CampaignEvent[]
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DM or PLAYER
  role       String
  joinedAt   DateTime @default(now())

  @@unique([campaignId, userId])
}

model CampaignCharacter {
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([campaignId, characterId])
}

/// Append-only log that drives chat, rolls and (later) combat. Clients stream it with Last-Event-ID.
model CampaignEvent {
  id         Int      @id @default(autoincrement())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actorId    String?
  /// chat | roll | system
  type       String
  payload    Json
  /// ALL, DM, or USER:<userId> (whisper); the actor and the DM can always see their own whispers
  audience   String   @default("ALL")
  createdAt  DateTime @default(now())

  @@index([campaignId, id])
}

/// Handbook rules chapters split into linkable sections (chapters 7-10, gods, planes, reading list).
model RuleSection {
  id           String @id
  chapter      String
  chapterTitle String
  title        String
  slug         String
  body         String
  position     Int
  source       String @default("PHB")
  pdfPage      Int?

  @@unique([chapter, slug])
  @@index([chapter, position])
}

model Language {
  index  String @id
  name   String
  /// Standard or Exotic (PHB p.123)
  type   String
  script String
  source String @default("PHB")
}

model Subclass {
  index      String @id
  classIndex String
  name       String
  text       String
  source     String @default("PHB")
  pdfPage    Int?

  @@index([classIndex])
}
