generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Accounts are username + password only (no third-party sign-in).
model User {
  id           String           @id @default(cuid())
  /// lowercase login name, 3-24 characters: a-z, 0-9, underscore
  username     String           @unique
  displayName  String
  /// scrypt hash, see lib/password.ts
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  characters   Character[]
  memberships  CampaignMember[]
  campaignsDm  Campaign[]
  journal      JournalEntry[]
}

// Rules content (seeded from content/, read-only at runtime)
model Alignment {
  index        String @id
  name         String
  abbreviation String
  description  String
  source       String @default("PHB")
  page         Int?
}

model Condition {
  index       String @id
  name        String
  description String
  source      String @default("PHB")
  pdfPages    Int[]
}

model Feat {
  index        String  @id
  name         String
  prerequisite String?
  description  String
  source       String  @default("PHB")
  pdfPages     Int[]
}

model Background {
  index              String  @id
  name               String
  skillProficiencies String?
  toolProficiencies  String?
  languages          String?
  equipment          String?
  featureName        String?
  text               String
  source             String  @default("PHB")
  pdfPages           Int[]
}

model Spell {
  index         String   @id
  name          String
  level         Int
  school        String
  ritual        Boolean  @default(false)
  concentration Boolean  @default(false)
  castingTime   String
  range         String
  components    String
  duration      String
  description   String
  higherLevels  String   @default("")
  classes       String[]
  source        String   @default("PHB")
  /// set for a homebrew spell, which only that campaign's heroes can learn
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([campaignId])
}

model Race {
  index    String @id
  name     String
  traits   Json
  text     String
  source   String @default("PHB")
  pdfPages Int[]
}

model Class {
  index         String @id
  name          String
  hitDie        Int
  proficiencies Json
  levelTable    Json
  text          String
  source        String @default("PHB")
  pdfPages      Int[]
}

model Creature {
  index             String  @id
  name              String
  size              String
  type              String
  alignment         String
  armorClass        String?
  hitPoints         String?
  speed             String?
  abilities         Json?
  savingThrows      String?
  skills            String?
  damageResistances String?
  senses            String?
  languages         String?
  challenge         String?
  text              String
  source            String  @default("PHB")
  pdfPages          Int[]
  /// set for homebrew monsters, which only that campaign can see
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model EquipmentItem {
  index               String   @id
  name                String
  category            String?
  cost                String
  weight              String?
  damage              String?
  properties          String?
  armorClass          String?
  strengthRequired    String?
  stealthDisadvantage Boolean?
  details             String   @default("")
  source              String   @default("PHB")
  pdfPage             Int
}

model Character {
  id                 String              @id @default(cuid())
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  raceIndex          String
  subraceIndex       String?
  backgroundIndex    String
  alignment          String?
  /// [{ classIndex, level, subclassIndex? }]
  classes            Json
  baseScores         Json
  abilityMethod      String
  /// racial bonuses plus ability score improvements, per ability
  scoreBonuses       Json                @default("{}")
  skillProficiencies Json                @default("[]")
  skillExpertise     Json                @default("[]")
  feats              Json                @default("[]")
  speed              Int                 @default(30)
  xp                 Int                 @default(0)
  inspiration        Boolean             @default(false)
  /// penalty to d20 tests after being raised from the dead; fades by 1 per long rest
  rezPenalty         Int                 @default(0)
  currentHp          Int
  tempHp             Int                 @default(0)
  hitDiceSpent       Json                @default("{}")
  deathSaves         Json                @default("{\"successes\":0,\"failures\":0}")
  conditions         Json                @default("[]")
  exhaustion         Int                 @default(0)
  currency           Json                @default("{\"cp\":0,\"sp\":0,\"ep\":0,\"gp\":0,\"pp\":0}")
  equipment          Json                @default("[]")
  spellSlotsUsed     Json                @default("[]")
  resources          Json                @default("[]")
  personality        Json                @default("{}")
  /// { known: string[], prepared: string[], spellbook: string[] } spell indexes
  spells             Json                @default("{}")
  notes              String              @default("")
  /// [{ id, creatureIndex, name, kind, hp, maxHp }] familiars, beast companions, wild shape forms, summons
  companions         Json                @default("[]")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  campaigns          CampaignCharacter[]
  combatants         Combatant[]

  @@index([ownerId])
}

model Campaign {
  id          String              @id @default(cuid())
  name        String
  description String              @default("")
  dmId        String
  dm          User                @relation(fields: [dmId], references: [id], onDelete: Cascade)
  inviteCode  String              @unique
  /// house rules: feats, multiclassing, encumbrance, ...
  settings    Json                @default("{}")
  createdAt   DateTime            @default(now())
  members     CampaignMember[]
  characters  CampaignCharacter[]
  events      CampaignEvent[]
  encounters  Encounter[]
  notes       JournalEntry[]
  sessions    GameSession[]
  npcs        Npc[]
  places      Location[]
  quests      Quest[]
  stash       StashItem[]
  homebrew       Creature[]
  homebrewSpells Spell[]
  /// in-game time: minutes since midnight of day 1 (starts at 8:00)
  clockMinutes Int                @default(480)
  /// light sources burning, party funds and other world state
  world       Json                @default("{}")
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DM or PLAYER
  role       String
  joinedAt   DateTime @default(now())

  @@unique([campaignId, userId])
  /// last time the member had the table open (presence)
  lastSeenAt DateTime?
}

model CampaignCharacter {
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([campaignId, characterId])
}

/// Append-only log that drives chat, rolls and (later) combat. Clients stream it with Last-Event-ID.
model CampaignEvent {
  id         Int      @id @default(autoincrement())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actorId    String?
  /// chat | roll | system
  type       String
  payload    Json
  /// ALL, DM, or USER:<userId> (whisper); the actor and the DM can always see their own whispers
  audience   String   @default("ALL")
  createdAt  DateTime @default(now())

  @@index([campaignId, id])
}

/// Handbook rules chapters split into linkable sections (chapters 7-10, gods, planes, reading list).
model RuleSection {
  id           String @id
  chapter      String
  chapterTitle String
  title        String
  slug         String
  body         String
  position     Int
  source       String @default("PHB")
  pdfPage      Int?

  @@unique([chapter, slug])
  @@index([chapter, position])
}

model Language {
  index  String @id
  name   String
  /// Standard or Exotic (PHB p.123)
  type   String
  script String
  source String @default("PHB")
}

model Subclass {
  index      String @id
  classIndex String
  name       String
  text       String
  source     String @default("PHB")
  pdfPage    Int?

  @@index([classIndex])
}

/// A fight at the table. State changes are logged as CampaignEvent rows (type "combat") with undo snapshots.
model Encounter {
  id          String      @id @default(cuid())
  campaignId  String
  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  /// PLANNED | ACTIVE | DONE
  state       String      @default("PLANNED")
  round       Int         @default(0)
  /// index into the initiative order of the creature whose turn it is
  activeIndex Int         @default(0)
  /// environment toggles: { underwater?: boolean }
  environment Json        @default("{}")
  /// grid size in 5 ft squares
  gridWidth   Int         @default(20)
  gridHeight  Int         @default(14)
  createdAt   DateTime    @default(now())
  combatants  Combatant[]

  @@index([campaignId])
}

model Combatant {
  id            String     @id @default(cuid())
  encounterId   String
  encounter     Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  /// character | monster | npc
  kind          String
  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  creatureIndex String?
  name          String
  initiative    Int?
  /// position in the turn order (0 = first)
  turnOrder     Int        @default(0)
  dexMod        Int        @default(0)
  ac            Int        @default(10)
  hp            Int        @default(1)
  maxHp         Int        @default(1)
  tempHp        Int        @default(0)
  speed         Int        @default(30)
  /// [{ condition, rounds?, source? }]
  conditions    Json       @default("[]")
  hidden        Boolean    @default(false)
  surprised     Boolean    @default(false)
  defeated      Boolean    @default(false)
  /// { successes, failures } for creatures making death saves
  deathSaves    Json       @default("{\"successes\":0,\"failures\":0}")
  /// resources for the current turn: action, bonus action, reaction, movement left, flags
  turn          Json       @default("{}")
  x             Int?
  y             Int?
  /// parsed attacks for monsters: [{ name, toHit, damage, damageType, reach, ranged }]
  attacks       Json       @default("[]")
  /// damage resistances / vulnerabilities / immunities
  defenses      Json       @default("{}")
  /// "Ready" action: free text trigger, cleared when used
  readied       String?
  /// { stable, attacksPerAction, concentrating, exhaustion, size, cr, grappledBy }
  extra         Json       @default("{}")
  createdAt     DateTime   @default(now())

  @@index([encounterId])
}

/// Journal: private notes, shared handouts and session write-ups for a campaign.
model JournalEntry {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// NOTE | HANDOUT | RECAP
  kind       String   @default("NOTE")
  title      String
  body       String   @default("")
  /// PRIVATE (author, plus the DM for handout drafts) or PARTY (everyone in the campaign)
  visibility String   @default("PRIVATE")
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId, kind])
}

/// A play session. Ending one saves a recap; the next session opens with it.
model GameSession {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  number     Int
  title      String    @default("")
  /// ACTIVE | ENDED
  status     String    @default("ACTIVE")
  summary    String    @default("")
  /// where the party left off: location/hook for the next session
  nextUp     String    @default("")
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  @@unique([campaignId, number])
}

model Npc {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  role       String   @default("")
  /// friendly | indifferent | hostile (PHB p.185)
  attitude   String   @default("indifferent")
  notes      String   @default("")
  /// hidden from players until the DM reveals them
  revealed   Boolean  @default(false)
  locationId String?
  creatureIndex String?
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

model Location {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  /// https image shown as the scene backdrop
  imageUrl    String   @default("")
  revealed    Boolean  @default(false)
  /// the scene currently shown to the table
  current     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([campaignId])
}

model Quest {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  reward      String   @default("")
  /// ACTIVE | DONE | FAILED
  status      String   @default("ACTIVE")
  revealed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([campaignId])
}

model StashItem {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int      @default(1)
  notes      String   @default("")
  valueCp    Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([campaignId])
}
